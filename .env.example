# Copy to `.env` and fill in real keys. Never commit `.env`.
# `.venv/` is the Python virtualenv — do not put secrets there.
#
# Required for live fetches (optional if you rely on on-disk caches only):
#   ODDS_API_KEY      The Odds API — NFL totals/spreads (https://the-odds-api.com)
#   WEATHER_API_KEY   Weather Company / weather.com developer API key
#                     (Currents On Demand: api.weather.com/v3/wx/observations/current)

ODDS_API_KEY=
WEATHER_API_KEY=
