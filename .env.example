# Copy to `.env` and fill in real keys. Never commit `.env`.
# `.venv/` is the Python virtualenv — do not put secrets there.
#
# Required for live Vegas fetches (optional if you rely on the on-disk odds cache):
#   ODDS_API_KEY      The Odds API — NFL totals/spreads (https://the-odds-api.com)
#
# Weather uses the National Weather Service (https://api.weather.gov) and does not
# need a key.

ODDS_API_KEY=

# Optional. Cookie header from a logged-in DraftKings contest CSV download.
# Used by scripts/harvest_contests.py. Never commit a real value.
DK_COOKIE=
